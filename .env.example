# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env закоммичен в репозиторий быть НЕ ДОЛЖЕН.

# === База данных Microsoft SQL Server ===
DB_USER=VitEnergoUser
DB_PASSWORD=replace_with_strong_password
DB_SERVER=localhost
DB_DATABASE=VitEnergoProject
# Доверять self-signed TLS-сертификату СУБД. true — для локальной/контейнерной mssql
# (в docker-compose уже выставлено true). Для внешней СУБД с валидным сертификатом — false.
DB_TRUST_SERVER_CERT=true

# === Среда выполнения ===
NODE_ENV=development
PORT=3000

# === JWT-секреты (сгенерировать через: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ===
# ВАЖНО: JWT_SECRET и REFRESH_TOKEN_SECRET должны различаться (сервер падает при равенстве на старте).
# Минимальная длина — 32 символа (Block V hardening).
JWT_SECRET=replace_with_64_byte_random_hex
REFRESH_TOKEN_SECRET=replace_with_DIFFERENT_64_byte_random_hex

# === Опциональная защита: антивирусное сканирование загружаемых файлов ===
# Для активации требуется установленный clamd (ClamAV) на хосте.
# ENABLE_CLAMAV=true

# === Параметры docker-compose (используются при docker compose up) ===
# Пароль администратора MSSQL внутри контейнера.
# В compose-конфигурации app использует sa/этот пароль для подключения.
MSSQL_SA_PASSWORD=VitEnergo123!

# === CSRF / Origin guard ===
# Дополнительные разрешённые origin'ы (запятая-разделённый список).
# Same-origin (тот же host) всегда разрешён — здесь только внешние,
# например прод-домен или вторая копия для тестирования.
# Пустое значение (или отсутствие переменной) — only same-origin.
# ALLOWED_ORIGINS=https://intranet.vitebskenergo.by,https://staging.vitenergo.local

# === Доверие к обратному прокси (X-Forwarded-For) ===
# Включить ТОЛЬКО если сервер стоит за nginx/traefik/ALB и они выставляют
# X-Forwarded-For. Иначе атакующий подменяет IP в логах + байпасит rate-limit.
# По умолчанию выключено — Express берёт IP из реального TCP-соединения.
# BEHIND_PROXY=true

# === Rate-limit caps (см. docs/PRODUCTION.md) ===
# В production hard-fail при значениях выше: AUTH=30, UPLOAD=10, REQUEST=100, COMMENT=300.
# Если NODE_ENV=production и хоть одна переменная превышает потолок — сервер
# не стартует (защита от копирования dev-.env в прод). На dev/smoke поднимаем
# выше — тесты создают много операций.
#
# Auth-эндпоинты (POST /api/login + /api/refresh-token), окно 15 мин:
# AUTH_LIMITER_MAX=10
#
# Multipart-uploads (POST /api/requests + /api/requests/:id/documents), окно 1 мин:
# UPLOAD_LIMITER_MAX=3
#
# Per-user POST /api/requests, окно 1 час:
# REQUEST_CREATE_MAX=30
#
# Per-user POST /api/requests/:id/comments, окно 1 час:
# COMMENT_CREATE_MAX=120
